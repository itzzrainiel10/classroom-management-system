{
  "expo": {
    "name": "CvSU CMS",
    "slug": "cvsu-cms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cvsucms",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ph.edu.cvsu.cms",
      "supportsTablet": true
    },
    "android": {
      "package": "ph.edu.cvsu.cms",
      "adaptiveIcon": {
        "backgroundColor": "#2C574B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#075B39",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "CvSU CMS uses the camera to scan paper answer sheets (OMR).",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aae2c068-5b18-4605-9847-bb940c94d25b"
      }
    }
  }
}
